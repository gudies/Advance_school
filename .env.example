# Firebase Realtime Database Sync Configuration
# To enable cloud sync, create a copy of this file named '.env' and fill in your Firebase Database URL.

# The REST URL of your Firebase Realtime Database
# Example: https://your-app-id-default-rtdb.firebaseio.com
VITE_FIREBASE_DB_URL=

# (Optional) Namespace to prefix database paths (useful if sharing database across different instances)
# Example: dev or prod
VITE_FIREBASE_NAMESPACE=
